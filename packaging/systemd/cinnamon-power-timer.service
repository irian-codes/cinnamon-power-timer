[Unit]
Description=Cinnamon Power Timer per-user timer service
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=dbus
BusName=org.irian.CinnamonPowerTimer
ExecStart=/usr/lib/cinnamon-power-timer/cinnamon_power_timer_service.py
Restart=on-failure
RestartSec=1
TimeoutStopSec=5
