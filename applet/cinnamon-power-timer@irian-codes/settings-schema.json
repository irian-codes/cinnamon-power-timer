{
  "cancellation-delay-seconds": {
    "type": "spinbutton",
    "default": 3,
    "min": 0,
    "max": 30,
    "step": 1,
    "description": "Cancellation delay (seconds)"
  },
  "maximum-countdown-days": {
    "type": "spinbutton",
    "default": 30,
    "min": 1,
    "max": 99,
    "step": 1,
    "description": "Maximum countdown duration (days)"
  },
  "remaining-time-format": {
    "type": "combobox",
    "default": "units",
    "options": {
      "02 d 12 h 23 m": "units",
      "02:12:23": "colon"
    },
    "description": "Panel remaining time format"
  },
  "warning-one-enabled": {
    "type": "checkbox",
    "default": true,
    "description": "Enable first warning"
  },
  "warning-one-minutes": {
    "type": "spinbutton",
    "default": 30,
    "min": 1,
    "max": 1440,
    "step": 1,
    "description": "First warning threshold (minutes)"
  },
  "warning-two-enabled": {
    "type": "checkbox",
    "default": true,
    "description": "Enable second warning"
  },
  "warning-two-minutes": {
    "type": "spinbutton",
    "default": 5,
    "min": 1,
    "max": 1440,
    "step": 1,
    "description": "Second warning threshold (minutes)"
  },
  "cancel-on-user-switch": {
    "type": "checkbox",
    "default": false,
    "description": "Cancel timer when switching users"
  }
}
